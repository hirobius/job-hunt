{
  "name": "apply-board",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "playwright test -c playwright.smoke.config.ts",
    "gallery": "node scripts/gallery.mjs",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/make-screenshots.mjs",
    "perf": "node scripts/perf-bench.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "sync:dry-run": "node --experimental-strip-types --no-warnings scripts/dry-run-sync.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:hds && npm run test && npm run build",
    "check:hds": "node scripts/check-hds.mjs",
    "hds:check": "node scripts/hds-check.mjs",
    "test:layout": "playwright test e2e/layout-rules.spec.ts",
    "test:visual": "node scripts/visual-docker.mjs",
    "verify:ui": "npm run hds:check && playwright test e2e/layout-rules.spec.ts && npm run test:visual",
    "seed:companies": "node scripts/seed-companies.mjs",
    "boards:discover": "node scripts/discover-boards.mjs",
    "discover:boards": "node scripts/discover-boards-refresh.mjs",
    "check:exact-pins": "node scripts/check-exact-pins.mjs",
    "check:figma-drift": "node scripts/check-figma-drift.mjs",
    "check:figma-fidelity": "node scripts/figma/fidelity.mjs",
    "figma:spec": "node scripts/figma/extract.mjs",
    "figma:push": "node scripts/figma/push.mjs",
    "prepare": "husky",
    "learned:check": "node scripts/check-learned-trailer.mjs"
  },
  "dependencies": {
    "@hirobius/design-system": "0.41.0",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "2.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hirobius/hds-toolkit": "https://npm.pkg.github.com/download/@hirobius/hds-toolkit/0.1.1/84aed6abb8f2302850bc75c560f5bd18925ff58f",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-axe": "0.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
