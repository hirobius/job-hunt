# @hirobius/* comes from GitHub Packages (HDS re-tier, hirobius/ops#691).
# HDS_PACKAGES_TOKEN: classic PAT with read:packages, set in Vercel env and the cloud env.
@hirobius:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${HDS_PACKAGES_TOKEN}
# The lockfile resolves @hirobius/design-system from public npm (GitHub Packages stops at 0.26.2);
# keep resolved URLs as written instead of swapping registry.npmjs.org for the scope registry.
replace-registry-host=never
