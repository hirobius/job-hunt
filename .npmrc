# No @hirobius scope mapping (job-hunt#567): @hirobius/design-system resolves from public npm.
# @hirobius/hds-toolkit is private on GitHub Packages; package.json pins it by its full tarball URL,
# so only this auth line is needed. HDS_PACKAGES_TOKEN: classic PAT with read:packages.
//npm.pkg.github.com/:_authToken=${HDS_PACKAGES_TOKEN}
# Keep lockfile resolved URLs as written.
replace-registry-host=never
# Dependency policy (hirobius/ops#1081): npm install writes exact versions, never ^ranges.
# scripts/check-exact-pins.mjs (npm run check:exact-pins, src/exactPins.test.ts) enforces it.
save-exact=true
